---
---
<footer class="bg-white border-t border-slate-200 mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <div class="col-span-1 md:col-span-1">
        <img class="h-8 w-auto mb-4" src="/images/landing/logo-dark.svg" alt="Handshake Logo" />
        <p class="text-slate-500 text-sm">
          Decentralized naming and certificate authority. An experimental peer-to-peer root naming system.
        </p>
      </div>
      
      <div>
        <h3 class="text-sm font-semibold text-slate-900 tracking-wider uppercase mb-4">Handshake</h3>
        <ul class="space-y-3">
          <li><a href="/" class="text-slate-600 hover:text-black text-sm">Home</a></li>
          <li><a href="/community" class="text-slate-600 hover:text-black text-sm">Community</a></li>
          <li><a href="/grant-sponsors" class="text-slate-600 hover:text-black text-sm">Grant Sponsors</a></li>
          <li><a href="/assets" class="text-slate-600 hover:text-black text-sm">Brand Assets</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-slate-900 tracking-wider uppercase">Learn</h3>
        <ul class="mt-4 space-y-3">
          <li><a href="/faq" class="text-slate-600 hover:text-black text-sm">FAQ</a></li>
          <li><a href="/notice" class="text-slate-600 hover:text-black text-sm">Notices</a></li>
          <li><a href="/files/handshake.txt" class="text-slate-600 hover:text-black text-sm">Whitepaper / Design Notes</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-slate-900 tracking-wider uppercase mb-4">Develop</h3>
        <ul class="space-y-3">
          <li><a href="https://handshake-org.github.io" class="text-slate-600 hover:text-black text-sm">Documentation</a></li>
          <li><a href="https://github.com/handshake-org/hsd" class="text-slate-600 hover:text-black text-sm">Run a full node</a></li>
          <li><a href="https://github.com/handshake-org/hnsd" class="text-slate-600 hover:text-black text-sm">Install an SPV resolver</a></li>
          <li><a href="https://handshake-org.github.io/guides/auctions.html" class="text-slate-600 hover:text-black text-sm">Auction system guide</a></li>
        </ul>
      </div>
    </div>
    
    <div class="mt-12 border-t border-slate-200 pt-8 flex flex-col md:flex-row justify-between items-center">
      <div class="flex flex-wrap gap-x-6 gap-y-4 mb-4 md:mb-0 text-sm">
        <a href="/terms-of-use" class="text-slate-500 hover:text-black">Terms of Use</a>
        <a href="/privacy-policy" class="text-slate-500 hover:text-black">Privacy Policy</a>
        <a href="/trademark-disclaimer" class="text-slate-500 hover:text-black">Trademark Disclaimer</a>
        <a href="/sitemap" class="text-slate-500 hover:text-black">Sitemap</a>
        <span class="text-slate-300 hidden md:inline">|</span>
        <a href="/skill.md" class="text-slate-500 hover:text-black">AI Agent Skill</a>
        <a href="/llms.txt" class="text-slate-500 hover:text-black">LLMs Info</a>
      </div>
      <div class="flex space-x-6">
        <a href="https://github.com/handshake-org/" class="text-slate-400 hover:text-black transition-opacity">
          <span class="sr-only">GitHub</span>
          <img src="/img/footer/github.svg" class="h-6 w-6 brightness-0 opacity-50 hover:opacity-100 transition-all" alt="GitHub" />
        </a>
        <a href="https://twitter.com/hns" class="text-slate-400 hover:text-black transition-opacity">
          <span class="sr-only">Twitter</span>
          <img src="/img/footer/twitter.svg" class="h-6 w-6 brightness-0 opacity-50 hover:opacity-100 transition-all" alt="Twitter" />
        </a>
        <a href="https://reddit.com/r/handshake" class="text-slate-400 hover:text-black transition-opacity">
          <span class="sr-only">Reddit</span>
          <img src="/img/footer/reddit.svg" class="h-6 w-6 brightness-0 opacity-50 hover:opacity-100 transition-all" alt="Reddit" />
        </a>
      </div>
    </div>
  </div>
</footer>