---
---
<header class="fixed w-full top-0 z-50 bg-white/90 backdrop-blur-md border-b border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <div class="flex-shrink-0 flex items-center">
        <a href="/" class="flex items-center gap-2">
          <!-- Using the original logo -->
          <img class="h-8 w-auto" src="/images/landing/logo-dark.svg" alt="Handshake Logo" />
        </a>
      </div>
      <nav class="hidden md:flex space-x-8">
        <a href="https://handshake-org.github.io" class="text-slate-600 hover:text-black font-medium transition-colors">Documentation</a>
        <a href="/community" class="text-slate-600 hover:text-black font-medium transition-colors">Community</a>
        <a href="/faq" class="text-slate-600 hover:text-black font-medium transition-colors">FAQ</a>
        <a href="/grant-sponsors" class="text-slate-600 hover:text-black font-medium transition-colors">Grant Sponsors</a>
      </nav>
      <!-- Mobile menu button -->
      <div class="md:hidden flex items-center">
        <button id="mobile-menu-btn" class="text-slate-600 hover:text-slate-900 focus:outline-none">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>
  
  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-slate-200">
    <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3">
      <a href="https://handshake-org.github.io" class="block px-3 py-2 rounded-md text-base font-medium text-slate-700 hover:text-black hover:bg-slate-50">Documentation</a>
      <a href="/community" class="block px-3 py-2 rounded-md text-base font-medium text-slate-700 hover:text-black hover:bg-slate-50">Community</a>
      <a href="/faq" class="block px-3 py-2 rounded-md text-base font-medium text-slate-700 hover:text-black hover:bg-slate-50">FAQ</a>
      <a href="/grant-sponsors" class="block px-3 py-2 rounded-md text-base font-medium text-slate-700 hover:text-black hover:bg-slate-50">Grant Sponsors</a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if(btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>