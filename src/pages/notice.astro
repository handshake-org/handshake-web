---
import Layout from '../layouts/Layout.astro';
import '../styles/legacy-content.css';
---
<Layout title="Handshake | notice">
  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold text-slate-900 mb-8 capitalize">notice</h1>
      <div class="prose prose-slate prose-lg">
        <p>This page has been migrated to the new modern Astro architecture.</p>
        <p>Original content from legacy/notice/index.html is being preserved and adapted.</p>
      </div>
    </div>
  </section>
</Layout>
