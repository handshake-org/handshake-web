>
  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 prose prose-slate prose-lg legacy-content">
      <section id="faucet" class="default">
    <div class="section-wrapper">
      <div class="hero-no-split">
        <h1 class="low-margin">How it Works</h1>
        <p>The prior statements in this document is retracted. Please see the <a href="/files/handshake.txt" class="underline font-medium hover:text-black">design notes</a> (Section: "Further Distribution") for more information.</p>
      </div>
     </div>
  </section>
    </div>
  </section>
</Layout>
