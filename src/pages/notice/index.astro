---
import Layout from '../../layouts/Layout.astro';
import '../../styles/legacy-content.css';
---
<Layout 
  title="Handshake | Notices"
  description="Read public notices and disclosures from the Handshake community."
>
  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold text-slate-900 mb-8 capitalize">Notices</h1>
      <div class="prose prose-slate prose-lg">
        <p>Public notices and disclosures from the Handshake community:</p>
        <ul>
          <li><a href="/notice/2020-04-02-Inflation-Bug-Disclosure" class="text-slate-600 hover:text-black font-medium underline">2020-04-02 Re-Claim Inflation Bug: Full Disclosure</a></li>
          <li><a href="/notice/2020-06-09-coinmarketcap" class="text-slate-600 hover:text-black font-medium underline">2020-06-09 CoinMarketCap Self-Reporting Portal Verification</a></li>
        </ul>
      </div>
    </div>
  </section>
</Layout>
