---
import Layout from '../../layouts/Layout.astro';
import '../../styles/legacy-content.css';
---
<Layout title="CMC Self-Reporting Portal Verification">
  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 prose prose-slate prose-lg legacy-content">
      <div class="mb-10">
        <h1 class="text-4xl font-bold text-slate-900 mb-8">CoinMarketCap <br> Self-Reporting Portal <br> Verification</h1>
        <p>CoinMarketCap: We would like to register one handshake.org email to manage Handshake's self-reporting dashboard on CoinMarketCap.</p>
        <p>matthew@handshake.org</p>
        <p><a href="https://coinmarketcap.com/currencies/handshake/">https://coinmarketcap.com/currencies/handshake/</a></p>
      </div>
    </div>
  </section>
</Layout>