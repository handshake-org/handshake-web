---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Handshake | Brand Assets"
  description="Download official Handshake brand assets, logos, and wordmarks. All Handshake logos are free and open source."
>
  <section class="py-20 bg-white min-h-[70vh]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold text-slate-900 mb-6">Brand Assets</h1>
      
      <div class="prose prose-slate prose-lg mb-12">
        <p>
          The Handshake logo and all related brand assets are <strong>free and open source</strong>. 
          You are encouraged to use them freely in your projects, applications, and communities to help grow the Handshake network.
        </p>
        <p>
          <a href="/logos/handshakelogos.zip" class="inline-block px-6 py-3 bg-slate-900 text-white font-medium rounded-lg hover:bg-black transition-colors no-underline">
            Download All Assets (.zip)
          </a>
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Monograms -->
        <div class="bg-slate-50 p-6 rounded-2xl border border-slate-100 flex flex-col items-center justify-center text-center">
          <div class="bg-white p-8 rounded-xl shadow-sm mb-4 w-full flex justify-center">
            <img src="/logos/Handshake-monogram-black.png" alt="Handshake Monogram Black" class="h-24 w-auto object-contain" />
          </div>
          <h3 class="font-semibold text-slate-900 mb-2">Monogram (Black)</h3>
          <a href="/logos/Handshake-monogram-black.png" download class="text-sm text-slate-500 hover:text-slate-900">Download PNG</a>
        </div>

        <div class="bg-slate-900 p-6 rounded-2xl border border-slate-800 flex flex-col items-center justify-center text-center">
          <div class="bg-black/50 p-8 rounded-xl mb-4 w-full flex justify-center">
            <img src="/logos/Handshake-monogram-white.png" alt="Handshake Monogram White" class="h-24 w-auto object-contain" />
          </div>
          <h3 class="font-semibold text-white mb-2">Monogram (White)</h3>
          <a href="/logos/Handshake-monogram-white.png" download class="text-sm text-slate-400 hover:text-white">Download PNG</a>
        </div>

        <!-- Outlined Monograms -->
        <div class="bg-slate-50 p-6 rounded-2xl border border-slate-100 flex flex-col items-center justify-center text-center">
          <div class="bg-white p-8 rounded-xl shadow-sm mb-4 w-full flex justify-center">
            <img src="/logos/Handshake-monogram-outlined-black.png" alt="Handshake Monogram Outlined Black" class="h-24 w-auto object-contain" />
          </div>
          <h3 class="font-semibold text-slate-900 mb-2">Monogram Outlined (Black)</h3>
          <a href="/logos/Handshake-monogram-outlined-black.png" download class="text-sm text-slate-500 hover:text-slate-900">Download PNG</a>
        </div>

        <div class="bg-slate-900 p-6 rounded-2xl border border-slate-800 flex flex-col items-center justify-center text-center">
          <div class="bg-black/50 p-8 rounded-xl mb-4 w-full flex justify-center">
            <img src="/logos/Handshake-monogram-outlined-white.png" alt="Handshake Monogram Outlined White" class="h-24 w-auto object-contain" />
          </div>
          <h3 class="font-semibold text-white mb-2">Monogram Outlined (White)</h3>
          <a href="/logos/Handshake-monogram-outlined-white.png" download class="text-sm text-slate-400 hover:text-white">Download PNG</a>
        </div>

        <!-- Wordmarks -->
        <div class="bg-slate-50 p-6 rounded-2xl border border-slate-100 flex flex-col items-center justify-center text-center md:col-span-2 lg:col-span-1">
          <div class="bg-white p-8 rounded-xl shadow-sm mb-4 w-full flex justify-center">
            <img src="/logos/Handshake-wordmark-black.png" alt="Handshake Wordmark Black" class="h-16 w-auto object-contain" />
          </div>
          <h3 class="font-semibold text-slate-900 mb-2">Wordmark (Black)</h3>
          <a href="/logos/Handshake-wordmark-black.png" download class="text-sm text-slate-500 hover:text-slate-900">Download PNG</a>
        </div>

        <div class="bg-slate-900 p-6 rounded-2xl border border-slate-800 flex flex-col items-center justify-center text-center md:col-span-2 lg:col-span-1">
          <div class="bg-black/50 p-8 rounded-xl mb-4 w-full flex justify-center">
            <img src="/logos/Handshake-wordmark-white.png" alt="Handshake Wordmark White" class="h-16 w-auto object-contain" />
          </div>
          <h3 class="font-semibold text-white mb-2">Wordmark (White)</h3>
          <a href="/logos/Handshake-wordmark-white.png" download class="text-sm text-slate-400 hover:text-white">Download PNG</a>
        </div>

      </div>
    </div>
  </section>
</Layout>